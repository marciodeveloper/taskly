# Configuration-only template. Never deploy with placeholder secrets.
APP_NAME=Taskly
APP_ENV=production
APP_KEY=REPLACE_WITH_ONE_TIME_GENERATED_LARAVEL_KEY
APP_DEBUG=false
APP_URL=https://taskly.webarthem.com
FRONTEND_URL=https://taskly.webarthem.com
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=taskly
DB_USERNAME=taskly
DB_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD

SANCTUM_STATEFUL_DOMAINS=taskly.webarthem.com
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr

# Configure real SMTP before public password reset is usable.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@taskly.webarthem.com
MAIL_FROM_NAME=Taskly

TASKLY_WEB_PORT=13080
TASKLY_API_PORT=18081
TASKLY_ENV_FILE=.env.production.example
